rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isBootstrappedAdmin() {
      return isSignedIn() && request.auth.token.email == 'kapilamedsirsi1@gmail.com';
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Users Collection ---
    match /users/{userId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isBootstrappedAdmin();
    }

    // --- Staff Collection ---
    match /staff/{staffId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isBootstrappedAdmin();
    }

    // --- Parties Collection ---
    match /parties/{partyId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isBootstrappedAdmin();
    }

    // --- Companies Collection ---
    match /companies/{companyId} {
      allow read: if true;
      allow write: if true;
    }

    // --- Products Collection ---
    match /products/{productId} {
      allow read: if true; // Public catalog for chemist ordering
      allow write: if true;
    }

    // --- Orders Collection ---
    match /orders/{orderId} {
      allow read: if isSignedIn() || true;
      allow create, update: if true;
      allow delete: if isBootstrappedAdmin();
    }

    // --- Payments Collection ---
    match /payments/{paymentId} {
      allow read: if isSignedIn() || true;
      allow create, update: if true;
      allow delete: if isBootstrappedAdmin();
    }

    // --- Expenses Collection ---
    match /expenses/{expenseId} {
      allow read: if isSignedIn() || true;
      allow create, update: if true;
      allow delete: if isBootstrappedAdmin();
    }

    // --- Visits Collection ---
    match /visits/{visitId} {
      allow read: if isSignedIn() || true;
      allow create, update: if true;
      allow delete: if isBootstrappedAdmin();
    }

    // --- Tours Collection ---
    match /tours/{tourId} {
      allow read: if isSignedIn() || true;
      allow write: if isSignedIn() || true;
    }

    // --- Attendance Collection ---
    match /attendance/{attendanceId} {
      allow read: if isSignedIn() || true;
      allow write: if isSignedIn() || true;
    }

    // --- Audit Logs Collection ---
    match /audit_logs/{logId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if false; // Immutable audit trail
    }

    // --- Notifications Collection ---
    match /notifications/{notificationId} {
      allow read, write: if true;
    }

    // --- Connection test collection ---
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
